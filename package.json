{
  "name": "tafseer-clipper",
  "private": true,
  "version": "0.1.4-beta",
  "type": "module",
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm run lint:py",
    "lint:py": "py -3.12 -m compileall -q backend || python -m compileall -q backend",
    "test": "npm run test:rust && npm run test:backend && npm run test:e2e",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:backend": "py -3.12 backend/test_phase1_e2e.py",
    "build:rust": "cargo build --manifest-path src-tauri/Cargo.toml --release --locked"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "wavesurfer.js": "^8.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
