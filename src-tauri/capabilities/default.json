{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: core APIs, opener, native file dialogs, and scoped read/write access to .tafseer project files. Spawning the FastAPI sidecar happens in Rust, so the webview is granted no shell permission.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$LOCALDATA/**" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$LOCALDATA/**" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$LOCALDATA/**" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$LOCALDATA/**" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$LOCALDATA/**" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" }
      ]
    }
  ]
}
